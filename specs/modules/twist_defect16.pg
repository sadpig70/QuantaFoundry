qs[1] = bb.add(Hadamard(), q=qs[1])
qs[0] = bb.add(Hadamard(), q=qs[0])
qs[15] = bb.add(Hadamard(), q=qs[15])
qs[14], qs[15] = bb.add(CZ(), q1=qs[14], q2=qs[15])
qs[14] = bb.add(Hadamard(), q=qs[14])
qs[13] = bb.add(Hadamard(), q=qs[13])
qs[12], qs[13] = bb.add(CNOT(), ctrl=qs[12], target=qs[13])
qs[11] = bb.add(Hadamard(), q=qs[11])
qs[10], qs[15] = bb.add(CNOT(), ctrl=qs[10], target=qs[15])
qs[10], qs[14] = bb.add(CNOT(), ctrl=qs[10], target=qs[14])
qs[10], qs[11] = bb.add(CNOT(), ctrl=qs[10], target=qs[11])
qs[9], qs[13] = bb.add(CNOT(), ctrl=qs[9], target=qs[13])
qs[8], qs[12] = bb.add(CNOT(), ctrl=qs[8], target=qs[12])
qs[7] = bb.add(Hadamard(), q=qs[7])
qs[6], qs[9] = bb.add(CZ(), q1=qs[6], q2=qs[9])
qs[6] = bb.add(SGate(), q=qs[6])
qs[6] = bb.add(SGate(), q=qs[6])
qs[6] = bb.add(SGate(), q=qs[6])
qs[6], qs[13] = bb.add(CNOT(), ctrl=qs[6], target=qs[13])
qs[6], qs[10] = bb.add(CNOT(), ctrl=qs[6], target=qs[10])
qs[6], qs[9] = bb.add(CNOT(), ctrl=qs[6], target=qs[9])
qs[5] = bb.add(Hadamard(), q=qs[5])
qs[4], qs[9] = bb.add(CNOT(), ctrl=qs[4], target=qs[9])
qs[4], qs[8] = bb.add(CNOT(), ctrl=qs[4], target=qs[8])
qs[4], qs[5] = bb.add(CNOT(), ctrl=qs[4], target=qs[5])
qs[3], qs[7] = bb.add(CNOT(), ctrl=qs[3], target=qs[7])
qs[3], qs[6] = bb.add(CNOT(), ctrl=qs[3], target=qs[6])
qs[2], qs[7] = bb.add(CNOT(), ctrl=qs[2], target=qs[7])
qs[2], qs[6] = bb.add(CNOT(), ctrl=qs[2], target=qs[6])
qs[2], qs[3] = bb.add(CNOT(), ctrl=qs[2], target=qs[3])
qs[1], qs[6] = bb.add(CZ(), q1=qs[1], q2=qs[6])
qs[1], qs[2] = bb.add(CZ(), q1=qs[1], q2=qs[2])
qs[1], qs[5] = bb.add(CNOT(), ctrl=qs[1], target=qs[5])
qs[0], qs[4] = bb.add(CNOT(), ctrl=qs[0], target=qs[4])
qs[9] = bb.add(XGate(), q=qs[9])
qs[13] = bb.add(XGate(), q=qs[13])
bloq = bb.finalize(**{f'q{i}': qs[i] for i in range(16)})
