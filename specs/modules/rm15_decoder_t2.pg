qs[7], qs[9] = bb.add(CNOT(), ctrl=qs[7], target=qs[9])
qs[7], qs[8] = bb.add(CNOT(), ctrl=qs[7], target=qs[8])
qs[3], qs[14] = bb.add(CNOT(), ctrl=qs[3], target=qs[14])
qs[3], qs[13] = bb.add(CNOT(), ctrl=qs[3], target=qs[13])
qs[3], qs[12] = bb.add(CNOT(), ctrl=qs[3], target=qs[12])
qs[3], qs[11] = bb.add(CNOT(), ctrl=qs[3], target=qs[11])
qs[3], qs[6] = bb.add(CNOT(), ctrl=qs[3], target=qs[6])
qs[3], qs[5] = bb.add(CNOT(), ctrl=qs[3], target=qs[5])
qs[3], qs[4] = bb.add(CNOT(), ctrl=qs[3], target=qs[4])
qs[1], qs[14] = bb.add(CNOT(), ctrl=qs[1], target=qs[14])
qs[1], qs[13] = bb.add(CNOT(), ctrl=qs[1], target=qs[13])
qs[1], qs[10] = bb.add(CNOT(), ctrl=qs[1], target=qs[10])
qs[1], qs[9] = bb.add(CNOT(), ctrl=qs[1], target=qs[9])
qs[1], qs[6] = bb.add(CNOT(), ctrl=qs[1], target=qs[6])
qs[1], qs[5] = bb.add(CNOT(), ctrl=qs[1], target=qs[5])
qs[1], qs[2] = bb.add(CNOT(), ctrl=qs[1], target=qs[2])
qs[0], qs[14] = bb.add(CNOT(), ctrl=qs[0], target=qs[14])
qs[0], qs[12] = bb.add(CNOT(), ctrl=qs[0], target=qs[12])
qs[0], qs[10] = bb.add(CNOT(), ctrl=qs[0], target=qs[10])
qs[0], qs[8] = bb.add(CNOT(), ctrl=qs[0], target=qs[8])
qs[0], qs[6] = bb.add(CNOT(), ctrl=qs[0], target=qs[6])
qs[0], qs[4] = bb.add(CNOT(), ctrl=qs[0], target=qs[4])
qs[0], qs[2] = bb.add(CNOT(), ctrl=qs[0], target=qs[2])
qs[7] = bb.add(Hadamard(), q=qs[7])
qs[3] = bb.add(Hadamard(), q=qs[3])
qs[1] = bb.add(Hadamard(), q=qs[1])
qs[0] = bb.add(Hadamard(), q=qs[0])
qs[14], qs[11] = bb.add(CNOT(), ctrl=qs[14], target=qs[11])
qs[14], qs[9] = bb.add(CNOT(), ctrl=qs[14], target=qs[9])
qs[14], qs[8] = bb.add(CNOT(), ctrl=qs[14], target=qs[8])
qs[14], qs[5] = bb.add(CNOT(), ctrl=qs[14], target=qs[5])
qs[14], qs[4] = bb.add(CNOT(), ctrl=qs[14], target=qs[4])
qs[14], qs[2] = bb.add(CNOT(), ctrl=qs[14], target=qs[2])
bloq = bb.finalize(**{f'q{i}': qs[i] for i in range(15)})
