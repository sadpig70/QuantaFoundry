{"id": "gf8_mulx", "n_sys": 3, "n_anc": 0}
```
```python id=app_golden
import numpy as np
NQ = 3
DIM = 8
def b3(x):
    return [(x >> (NQ - 1 - i)) & 1 for i in range(NQ)]
def f3(b):
    v = 0
    for i in range(NQ):
        v |= (b[i] & 1) << (NQ - 1 - i)
    return v
def mulx(a):                             # a·x mod x³+x+1 (독립 체 산술 참조 — C4)
    a2, a1, a0 = (a >> 2) & 1, (a >> 1) & 1, a & 1
    return (a1 << 2) | ((a0 ^ a2) << 1) | a2
golden = np.zeros((DIM, DIM), dtype=complex)
for x in range(DIM):
    golden[mulx(x), x] = 1.0 + 0.0j
```
