{"id": "cluster3x3_prep", "n_sys": 9, "n_anc": 0}
```
```python id=app_golden
import numpy as np
from functools import reduce
I = np.eye(2, dtype=complex)
Hd = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
NQ = 9
DIM = 1 << NQ
def emb(op, q):
    return reduce(np.kron, [op if i == q else I for i in range(NQ)])
def bits(x):
    return [(x >> (NQ - 1 - i)) & 1 for i in range(NQ)]
def cz(a, b):
    M = np.eye(DIM, dtype=complex)
    for x in range(DIM):
        bb = bits(x)
        if bb[a] and bb[b]:
            M[x, x] = -1.0
    return M
EDGES = [(0, 1), (1, 2), (3, 4), (4, 5), (6, 7), (7, 8),   # 수평
         (0, 3), (3, 6), (1, 4), (4, 7), (2, 5), (5, 8)]   # 수직
golden = np.eye(DIM, dtype=complex)
for q in range(NQ):                                        # |+>^⊗9
    golden = emb(Hd, q) @ golden
for (a, b) in EDGES:                                       # CZ per edge
    golden = cz(a, b) @ golden
```
