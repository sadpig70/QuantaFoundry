```python id=app_golden
import numpy as np
def s3_mul(a1, a0, bb, c1, c0, dd):
    dd ^= bb
    if bb:
        c1, c0 = c0, c1
    if (a1, a0) == (0, 1):
        if c1 == 0: c0 ^= 1
        if c0 == 0: c1 ^= 1
    if (a1, a0) == (1, 0):
        if c0 == 0: c1 ^= 1
        if c1 == 0: c0 ^= 1
    return c1, c0, dd
def msig_w(a1, a0, b, w1, w0):
    if b:
        w1, w0 = w0, w1
    a = (a1 << 1) | a0
    for _ in range(a if a <= 2 else 0):
        w1, w0 = (w1 ^ w0, w1)
    return w1, w0
golden = np.zeros((1024, 1024), dtype=complex)
for x in range(1024):
    q = [(x >> (9 - i)) & 1 for i in range(10)]
    st1, st0, dd = s3_mul(q[2], q[3], q[4], q[7], q[8], q[9])
    sw1, sw0 = msig_w(q[2], q[3], q[4], q[5], q[6])
    out = [q[0], q[1], q[2], q[3], q[4], q[0] ^ sw1, q[1] ^ sw0, st1, st0, dd]
    y = 0
    for i in range(10):
        y = (y << 1) | out[i]
    golden[y, x] = 1.0
```
