# choi_phasedamp — phase-damping 채널(λ=½)의 Choi 상태 준비 유니터리 (HE3 H3.3). wires: 0=ref, 1=sys, 2=env.
# Bell(ref,sys) 후 기봉인 stinespring_phasedamp sub-app(sys,env) — 신규 module 0. 봉인=유니터리(8×8)뿐,
# J(E)=관측(choi_observe, INV-Q3 상속).
```json id=app_meta
{"id": "choi_phasedamp", "n_sys": 3, "n_anc": 0}
```
```python id=app_golden
import numpy as np
I = np.eye(2, dtype=complex)
H = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
def ry(a):
    return np.array([[np.cos(a/2), -np.sin(a/2)], [np.sin(a/2), np.cos(a/2)]], dtype=complex)
def embN(op, q, n):
    ops = [I] * n; ops[q] = op
    M = ops[0]
    for o in ops[1:]:
        M = np.kron(M, o)
    return M
def cnotN(c, t, n):
    dim = 2 ** n; M = np.zeros((dim, dim), dtype=complex)
    for x in range(dim):
        b = [(x >> (n - 1 - q)) & 1 for q in range(n)]; b[t] ^= b[c]
        y = 0
        for bb in b:
            y = (y << 1) | bb
        M[y, x] = 1.0
    return M
# U_pd(2q) = CRY(π/2)(sys→env) — V6 닫힌형: P0⊗I + P1⊗Ry(π/2)
P0 = np.diag([1, 0]).astype(complex); P1 = np.diag([0, 1]).astype(complex)
U_pd = np.kron(P0, I) + np.kron(P1, ry(np.pi / 2))
golden = np.kron(I, U_pd) @ cnotN(0, 1, 3) @ embN(H, 0, 3)
```
