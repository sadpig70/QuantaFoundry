{"id": "qca_step", "n_sys": 4, "n_anc": 0}
```
```python id=app_golden
import numpy as np
from functools import reduce
I = np.eye(2, dtype=complex)
Hd = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
NQ = 4
DIM = 16
def emb(op, q):
    return reduce(np.kron, [op if i == q else I for i in range(NQ)])
def bits(x):
    return [(x >> (NQ - 1 - i)) & 1 for i in range(NQ)]
def cz(a, b):
    M = np.eye(DIM, dtype=complex)
    for x in range(DIM):
        bb = bits(x)
        if bb[a] and bb[b]:
            M[x, x] = -1.0
    return M
# brickwork QCA step: even bonds → H layer → odd bonds (주기경계 3-0)
gates = [cz(0, 1), cz(2, 3), emb(Hd, 0), emb(Hd, 1), emb(Hd, 2), emb(Hd, 3), cz(1, 2), cz(3, 0)]
golden = np.eye(DIM, dtype=complex)
for G in gates:
    golden = G @ golden
```
