```python id=app_golden
import numpy as np
from functools import reduce
I = np.eye(2, dtype=complex)
Hd = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
NQ = 4
DIM = 16
def kr(*m):
    return reduce(np.kron, m)
def emb(op, q):
    return kr(*[op if i == q else I for i in range(NQ)])
def b4(x):
    return [(x >> (NQ - 1 - i)) & 1 for i in range(NQ)]
def f4(b):
    v = 0
    for i in range(NQ):
        v |= (b[i] & 1) << (NQ - 1 - i)
    return v
def cnot(c, t):
    M = np.zeros((DIM, DIM), dtype=complex)
    for x in range(DIM):
        b = b4(x)
        b = b[:]; b[t] ^= b[c]
        M[f4(b), x] = 1.0
    return M
# encoder: CNOT(1,3)·CNOT(2,3) then H(0)·CNOT(0,1)·CNOT(0,2)·CNOT(0,3)
gates = [cnot(1, 3), cnot(2, 3), emb(Hd, 0), cnot(0, 1), cnot(0, 2), cnot(0, 3)]
golden = np.eye(DIM, dtype=complex)
for G in gates:
    golden = G @ golden
```
