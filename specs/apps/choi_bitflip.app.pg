```python id=app_golden
import numpy as np
I = np.eye(2, dtype=complex)
H = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
def ry(a):
    return np.array([[np.cos(a/2), -np.sin(a/2)], [np.sin(a/2), np.cos(a/2)]], dtype=complex)
def embN(op, q, n):
    ops = [I] * n; ops[q] = op
    M = ops[0]
    for o in ops[1:]:
        M = np.kron(M, o)
    return M
def cnotN(c, t, n):
    dim = 2 ** n; M = np.zeros((dim, dim), dtype=complex)
    for x in range(dim):
        b = [(x >> (n - 1 - q)) & 1 for q in range(n)]; b[t] ^= b[c]
        y = 0
        for bb in b:
            y = (y << 1) | bb
        M[y, x] = 1.0
    return M
# U_bf(2q, sys·env) = CNOT(env→sys)·Ry(π/2)_env — V6 닫힌형 그대로
U_bf = cnotN(1, 0, 2) @ embN(ry(np.pi / 2), 1, 2)
golden = np.kron(I, U_bf) @ cnotN(0, 1, 3) @ embN(H, 0, 3)
```
