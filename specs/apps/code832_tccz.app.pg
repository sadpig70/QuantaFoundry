```python id=app_golden
import numpy as np
w8 = np.exp(1j * np.pi / 4)
d = np.ones(256, dtype=complex)
for idx in range(256):
    ph = 0
    for q in range(8):
        if (idx >> (7 - q)) & 1:
            ph += 1 if bin(q).count("1") % 2 == 0 else -1
    d[idx] = w8 ** (ph % 8)
golden = np.diag(d)
```
