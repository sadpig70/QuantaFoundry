```python id=app_golden
import numpy as np
def gmul(a, b):
    r = 0
    for k in range(3):
        if (b >> k) & 1:
            r ^= a << k
    for d in (5, 4, 3):
        if (r >> d) & 1:
            r ^= (0b1011 << (d - 3))
    return r
golden = np.zeros((512, 512), dtype=complex)
for r0 in range(8):
    for r1 in range(8):
        for s in range(8):
            out = s ^ gmul(2, r0) ^ gmul(gmul(2, 2), r1)
            golden[(r0 << 6) | (r1 << 3) | out, (r0 << 6) | (r1 << 3) | s] = 1.0
```
