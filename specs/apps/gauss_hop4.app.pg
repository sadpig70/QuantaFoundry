{"id": "gauss_hop4", "n_sys": 4, "n_anc": 0}
```
```python id=app_golden
import numpy as np
I2 = np.eye(2, dtype=complex)
T = np.diag([1, np.exp(1j * np.pi / 4)]).astype(complex)
S = np.diag([1, 1j]).astype(complex)
Sd = np.diag([1, -1j]).astype(complex)
ISW = np.array([[1, 0, 0, 0], [0, 0, 1j, 0], [0, 1j, 0, 0], [0, 0, 0, 1]], dtype=complex)
def e1(g, i):
    m = np.eye(1, dtype=complex)
    for q in range(4):
        m = np.kron(m, g if q == i else I2)
    return m
def e2(g, i):
    return np.kron(np.kron(np.eye(2 ** i, dtype=complex), g), np.eye(2 ** (2 - i), dtype=complex))
golden = (e1(T, 1) @ e1(T, 2) @ e2(ISW, 1) @ e1(S, 2) @ e1(Sd, 1)
          @ e2(ISW, 0) @ e2(ISW, 2) @ e1(T, 0) @ e1(T, 1) @ e1(T, 2) @ e1(T, 3))
```
