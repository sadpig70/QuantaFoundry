```python id=app_golden
import numpy as np
def gmul(a, b):
    r = 0
    for k in range(3):
        if (b >> k) & 1:
            r ^= a << k
    for d in (5, 4, 3):
        if (r >> d) & 1:
            r ^= (0b1011 << (d - 3))
    return r
golden = np.zeros((512, 512), dtype=complex)
for a in range(8):
    for b in range(8):
        for t in range(8):
            golden[(a << 6) | (b << 3) | (t ^ gmul(a, b)), (a << 6) | (b << 3) | t] = 1.0
```
