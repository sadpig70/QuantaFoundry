```python id=app_golden
import numpy as np
NQ = 6
DIM = 64
def bits(x):
    return [(x >> (NQ - 1 - i)) & 1 for i in range(NQ)]
def frombits(b):
    v = 0
    for i in range(NQ):
        v |= (b[i] & 1) << (NQ - 1 - i)
    return v
def gf4_mul(a, b):                       # 독립 GF(4) 곱셈 (C4 참조)
    a1, a0 = (a >> 1) & 1, a & 1
    b1, b0 = (b >> 1) & 1, b & 1
    c1 = (a1 & b1) ^ (a1 & b0) ^ (a0 & b1)
    c0 = (a1 & b1) ^ (a0 & b0)
    return (c1 << 1) | c0
golden = np.zeros((DIM, DIM), dtype=complex)
for x in range(DIM):
    b = bits(x)
    a = (b[0] << 1) | b[1]
    bb = (b[2] << 1) | b[3]
    c = (b[4] << 1) | b[5]
    nc = c ^ gf4_mul(a, bb)
    golden[frombits([b[0], b[1], b[2], b[3], (nc >> 1) & 1, nc & 1]), x] = 1.0 + 0.0j
```
