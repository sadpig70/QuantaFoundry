```python id=app_golden
import numpy as np
import itertools
# 기약표현 공식으로 직접 구성 (C4 독립참조): 행=irrep 성분, 열=g=(-1)^{b0}·e_{(b2,b1)}
I2 = np.eye(2, dtype=complex)
Qv = {0:(1,0,0,0),1:(-1,0,0,0),2:(0,1,0,0),3:(0,-1,0,0),
      4:(0,0,1,0),5:(0,0,-1,0),6:(0,0,0,1),7:(0,0,0,-1)}
VEC = {v: i for i, v in Qv.items()}
def qmul(x, y):
    a0,a1,a2,a3 = Qv[x]; b0,b1,b2,b3 = Qv[y]
    return VEC[(a0*b0-a1*b1-a2*b2-a3*b3, a0*b1+a1*b0+a2*b3-a3*b2,
                a0*b2-a1*b3+a2*b0+a3*b1, a0*b3+a1*b2-a2*b1+a3*b0)]
rho = {0:I2, 1:-I2, 2:np.array([[1j,0],[0,-1j]]), 3:np.array([[-1j,0],[0,1j]]),
       4:np.array([[0,1],[-1,0]],dtype=complex), 5:np.array([[0,-1],[1,0]],dtype=complex)}
rho[6] = rho[2] @ rho[4]; rho[7] = -rho[6]
v4 = {0:(0,0),1:(0,0),2:(1,0),3:(1,0),4:(0,1),5:(0,1),6:(1,1),7:(1,1)}
elt = {(0,0):0,(0,1):2,(1,0):4,(1,1):6}
chars = [{g: ((-1)**(ci*v4[g][0]))*((-1)**(cj*v4[g][1])) for g in range(8)}
         for (ci, cj) in itertools.product([0, 1], repeat=2)]
golden = np.zeros((8, 8), dtype=complex)
for x in range(8):
    b2, b1, b0 = (x >> 2) & 1, (x >> 1) & 1, x & 1
    g = elt[(b2, b1)] if b0 == 0 else qmul(1, elt[(b2, b1)])
    for c in range(4):
        golden[c, x] = chars[c][g] / np.sqrt(8)            # 1-dim (√(1/8)·χ)
    r = 4
    for j in range(2):
        for k in range(2):
            golden[r, x] = rho[g][j, k] / 2                # 2-dim (√(2/8)·ρ_{jk})
            r += 1
```
