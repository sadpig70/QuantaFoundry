```python id=app_golden
import numpy as np
I = np.eye(2, dtype=complex)
X = np.array([[0, 1], [1, 0]], dtype=complex)
Z = np.array([[1, 0], [0, -1]], dtype=complex)
H = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
def emb(op, q):
    ops = [I, I, I]; ops[q] = op
    return np.kron(np.kron(ops[0], ops[1]), ops[2])
def ctrl(c, t, P):
    P0 = np.diag([1, 0]).astype(complex); P1 = np.diag([0, 1]).astype(complex)
    return emb(P0, c) + emb(P1, c) @ emb(P, t)
# 시간순: H(e1)·H(e0) → CNOT(e0→s) → CZ(e1→s).  s=0, e1=1, e0=2
golden = np.eye(8, dtype=complex)
for G in [emb(H, 1), emb(H, 2), ctrl(2, 0, X), ctrl(1, 0, Z)]:
    golden = G @ golden
```
