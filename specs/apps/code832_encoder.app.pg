{"id": "code832_encoder", "n_sys": 8, "n_anc": 0}
```
```python id=app_golden
import numpy as np
CN = [(2, 3), (1, 3), (4, 5), (1, 5), (4, 6), (2, 6), (4, 7), (2, 7), (1, 7)]
golden = np.zeros((256, 256), dtype=complex)
r2 = 1.0 / np.sqrt(2.0)
for z in range(256):
    b = [(z >> (7 - q)) & 1 for q in range(8)]
    for c, t in CN:
        if b[c]:
            b[t] ^= 1
    for u in (0, 1):
        amp = r2 * ((-1) ** (u * b[0]))
        nb = list(b)
        nb[0] = u
        if u:
            for t in range(1, 8):
                nb[t] ^= 1
        idx = 0
        for q in range(8):
            idx = (idx << 1) | nb[q]
        golden[idx, z] += amp
```
