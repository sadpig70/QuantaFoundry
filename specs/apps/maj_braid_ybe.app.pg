```python id=app_golden
import numpy as np
# Majorana braid word W=B12·B23·B12 직접 구성 (C4 독립참조)
I2 = np.eye(2, dtype=complex)
X = np.array([[0, 1], [1, 0]], dtype=complex)
Y = np.array([[0, -1j], [1j, 0]], dtype=complex)
Z = np.diag([1, -1]).astype(complex)
def kron(a, b): return np.kron(a, b)
G = {1: kron(X, I2), 2: kron(Y, I2), 3: kron(Z, X), 4: kron(Z, Y)}
def braid(i, j): return (np.eye(4) + G[i] @ G[j]) / np.sqrt(2)
golden = braid(1, 2) @ np.eye(4)
golden = braid(2, 3) @ golden
golden = braid(1, 2) @ golden
```
