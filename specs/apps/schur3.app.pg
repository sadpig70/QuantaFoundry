```python id=app_golden
import numpy as np
NQ = 3
DIM = 8
def idx(b):
    return sum((b[i] & 1) << (NQ - 1 - i) for i in range(NQ))
s2, s3, s6 = np.sqrt(2.0), np.sqrt(3.0), np.sqrt(6.0)
golden = np.zeros((DIM, DIM), dtype=complex)
def put(col, vec):
    for b, a in vec.items():
        golden[idx(list(b)), idx(list(col))] = a
# 열 = Schur 기저벡터 (CG 계수 직접 — 회로와 독립)
put((0, 0, 0), {(0, 0, 0): 1.0})                                                    # |3/2,+3/2>
put((0, 0, 1), {(0, 0, 1): 1/s3, (0, 1, 0): 1/s3, (1, 0, 0): 1/s3})                 # |3/2,+1/2> (W)
put((1, 0, 1), {(0, 1, 1): 1/s3, (1, 0, 1): 1/s3, (1, 1, 0): 1/s3})                 # |3/2,-1/2>
put((1, 1, 1), {(1, 1, 1): 1.0})                                                    # |3/2,-3/2>
put((1, 0, 0), {(1, 0, 0): 2/s6, (0, 0, 1): -1/s6, (0, 1, 0): -1/s6})               # |1/2,+1/2>_A
put((0, 1, 1), {(0, 1, 1): 2/s6, (1, 0, 1): -1/s6, (1, 1, 0): -1/s6})               # -|1/2,-1/2>_A
put((0, 1, 0), {(0, 0, 1): 1/s2, (0, 1, 0): -1/s2})                                 # |1/2,+1/2>_B
put((1, 1, 0), {(1, 0, 1): 1/s2, (1, 1, 0): -1/s2})                                 # |1/2,-1/2>_B
```
