```python id=app_golden
import numpy as np
def gf_mul(a, b):
    r = 0
    for i in range(3):
        if (b >> i) & 1:
            r ^= a << i
    for d in (5, 4, 3):
        if (r >> d) & 1:
            r ^= 0b1011 << (d - 3)      # x³ = x+1
    return r & 7
golden = np.zeros((8, 8), dtype=complex)
for a in range(8):
    golden[gf_mul(a, a), a] = 1.0
```
