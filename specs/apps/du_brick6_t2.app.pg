```python id=app_golden
import numpy as np
F1 = np.array([[1, 0, 0, 0], [0, 0, -1j, 0], [0, -1j, 0, 0], [0, 0, 0, 1]], dtype=complex)
p = np.exp(-1j * np.pi / 8)
V = F1 @ np.diag([p, np.conj(p), np.conj(p), p]).astype(complex)
N = 6
def emb2(g, i, j):
    dim = 2 ** N
    M = np.zeros((dim, dim), dtype=complex)
    for idx in range(dim):
        b = [(idx >> (N - 1 - q)) & 1 for q in range(N)]
        si = (b[i] << 1) | b[j]
        for so in range(4):
            a = g[so, si]
            if abs(a) < 1e-16:
                continue
            nb = list(b)
            nb[i], nb[j] = (so >> 1) & 1, so & 1
            oidx = 0
            for q in range(N):
                oidx = (oidx << 1) | nb[q]
            M[oidx, idx] += a
    return M
L1 = emb2(V, 0, 1) @ emb2(V, 2, 3) @ emb2(V, 4, 5)
L2 = emb2(V, 1, 2) @ emb2(V, 3, 4) @ emb2(V, 5, 0)
golden = L2 @ L1
```
