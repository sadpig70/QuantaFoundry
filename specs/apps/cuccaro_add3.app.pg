# cuccaro_add3 — 3-bit Cuccaro ripple-carry 가산기 (HE3 H3.1, cuccaro_add2 의 family 수직 1단).
# wires(w0=MSB): 0=a2 1=a1 2=a0 3=b2 4=b1 5=b0 6=cin 7=z. |a,b,cin,z⟩ → |a,(a+b+cin) mod 8,cin,z⊕carry⟩.
# MAJ×3 사다리 → carry copy → UMA×3 역사다리. {cnot,toffoli}만 — 신규 module 0.
# golden=정수산술 순열(회로 독립). dense 256×256 Tier-0.
```json id=app_meta
{"id": "cuccaro_add3", "n_sys": 8, "n_anc": 0}
```
```python id=app_golden
import numpy as np
n = 8; dim = 2 ** n
A, B, CIN, Z = [2, 1, 0], [5, 4, 3], 6, 7
golden = np.zeros((dim, dim), dtype=complex)
for basis in range(dim):
    bits = [(basis >> (n - 1 - q)) & 1 for q in range(n)]
    s = sum(bits[A[i]] << i for i in range(3)) + sum(bits[B[i]] << i for i in range(3)) + bits[CIN]
    out = list(bits)
    for i in range(3):
        out[B[i]] = (s >> i) & 1
    out[Z] ^= (s >> 3) & 1
    golden[int("".join(map(str, out)), 2), basis] = 1
```
