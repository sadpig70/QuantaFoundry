```python id=app_golden
import numpy as np
# fSWAP: SWAP 후 CZ (fermionic 반교환 부호를 |11>에 부여)
CZ = np.diag([1, 1, 1, -1]).astype(complex)
def cnot(c, t):
    M = np.zeros((4, 4), dtype=complex)
    for x in range(4):
        b = [(x >> 1) & 1, x & 1]
        b[t] ^= b[c]
        M[(b[0] << 1) | b[1], x] = 1.0
    return M
SWAP = cnot(0, 1) @ cnot(1, 0) @ cnot(0, 1)
golden = CZ @ SWAP
```
