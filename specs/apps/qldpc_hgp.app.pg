```python id=app_golden
import numpy as np
from functools import reduce
I = np.eye(2, dtype=complex)
Hd = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
NQ = 8
DIM = 256
def emb(op, q):
    return reduce(np.kron, [op if i == q else I for i in range(NQ)])
def bits(x):
    return [(x >> (NQ - 1 - i)) & 1 for i in range(NQ)]
def cnot(c, t):
    M = np.zeros((DIM, DIM), dtype=complex)
    for x in range(DIM):
        b = bits(x)
        b = b[:]; b[t] ^= b[c]
        M[sum((b[i] & 1) << (NQ - 1 - i) for i in range(NQ)), x] = 1.0
    return M
# CSS |0_L> prep: RREF-pivot(0,1,2,3) H(pivot)+CNOT(pivot→support)
gates = [emb(Hd, 0), cnot(0, 4), cnot(0, 6), cnot(0, 7),
         emb(Hd, 1), cnot(1, 5), cnot(1, 6), cnot(1, 7),
         emb(Hd, 2), cnot(2, 4), cnot(2, 7),
         emb(Hd, 3), cnot(3, 5), cnot(3, 7)]
golden = np.eye(DIM, dtype=complex)
for G in gates:
    golden = G @ golden
```
