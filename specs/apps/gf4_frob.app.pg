```python id=app_golden
import numpy as np
# GF(4) x↦x²: 00→00, 01→01, 10→11, 11→10 (독립 체 산술 참조 — C4)
def gf4_sq(a):
    a1, a0 = (a >> 1) & 1, a & 1
    return (a1 << 1) | (a0 ^ a1)
golden = np.zeros((4, 4), dtype=complex)
for x in range(4):
    golden[gf4_sq(x), x] = 1.0 + 0.0j
```
