```python id=app_golden
import numpy as np
NQ = 6; DIM = 64
def mult(a, b, c, d):
    return ((a + (c if b == 0 else (-c) % 4)) % 4, b ^ d)
# d4_mult 순열 (군법칙 직접): |g>|h> → |g>|gh>
MUL = np.zeros((DIM, DIM), dtype=complex)
for g in range(8):
    for h in range(8):
        ga, gb = g >> 1, g & 1
        ha, hb = h >> 1, h & 1
        pa, pb = mult(ga, gb, ha, hb)
        MUL[(g << 3) | ((pa << 1) | pb), (g << 3) | h] = 1.0
# d4_qft (기약표현 공식 직접)
F = np.zeros((8, 8), dtype=complex)
for a in range(4):
    for b in range(2):
        x = (a << 1) | b
        F[0, x] = 1 / np.sqrt(8)
        F[1, x] = (-1) ** b / np.sqrt(8)
        F[4, x] = (-1) ** a / np.sqrt(8)
        F[5, x] = (-1) ** (a + b) / np.sqrt(8)
        F[2, x] = (1j ** a) / 2 if b == 0 else 0
        F[3, x] = (1j ** a) / 2 if b == 1 else 0
        F[6, x] = ((-1j) ** a) / 2 if b == 0 else 0
        F[7, x] = ((-1j) ** a) / 2 if b == 1 else 0
H2 = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
def emb1(G, q):
    M = np.eye(1, dtype=complex)
    for i in range(NQ):
        M = np.kron(M, G if i == q else np.eye(2, dtype=complex))
    return M
golden = emb1(H2, 0)
golden = emb1(H2, 1) @ golden
golden = emb1(H2, 2) @ golden
golden = emb1(H2, 5) @ golden          # |H⟩ = (|000⟩+|001⟩)/√2 = {e, s}
golden = MUL @ golden
golden = np.kron(F, np.eye(8, dtype=complex)) @ golden
```
