```python id=app_golden
import numpy as np
I = np.eye(2, dtype=complex)
Hd = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
CZ = np.diag([1, 1, 1, -1]).astype(complex)
def cnot(c, t):
    M = np.zeros((4, 4), dtype=complex)
    for x in range(4):
        b = [(x >> 1) & 1, x & 1]
        b[t] ^= b[c]
        M[(b[0] << 1) | b[1], x] = 1.0
    return M
# coherent MBQC H-teleportation: CNOT(0,1)·H(0)·CZ  (CZ 먼저 적용)
golden = cnot(0, 1) @ np.kron(Hd, I) @ CZ
```
