```python id=app_golden
import numpy as np
def gf_mul(a, b):
    r = 0
    for i in range(3):
        if (b >> i) & 1:
            r ^= a << i
    for d in (5, 4, 3):
        if (r >> d) & 1:
            r ^= 0b1011 << (d - 3)      # x³ = x+1
    return r & 7
golden = np.zeros((8, 8), dtype=complex)
golden[0, 0] = 1.0
for a in range(1, 8):
    p = 1
    for _ in range(6):
        p = gf_mul(p, a)                 # a⁻¹ = a⁶
    golden[p, a] = 1.0
```
