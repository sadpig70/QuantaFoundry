```python id=app_golden
import numpy as np
from functools import reduce
I = np.eye(2, dtype=complex)
Hd = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
NQ = 8
DIM = 256
def emb(op, q):
    return reduce(np.kron, [op if i == q else I for i in range(NQ)])
def bits(x):
    return [(x >> (NQ - 1 - i)) & 1 for i in range(NQ)]
def frombits(b):
    v = 0
    for i in range(NQ):
        v |= (b[i] & 1) << (NQ - 1 - i)
    return v
def cnot(c, t):
    M = np.zeros((DIM, DIM), dtype=complex)
    for x in range(DIM):
        b = bits(x)
        b = b[:]; b[t] ^= b[c]
        M[frombits(b), x] = 1.0
    return M
# star-seed ground state prep: seeds 0,5,2 spread via CNOT over A00,A01,A10 support
gates = [emb(Hd, 0), cnot(0, 1), cnot(0, 4), cnot(0, 6),
         emb(Hd, 5), cnot(5, 0), cnot(5, 1), cnot(5, 7),
         emb(Hd, 2), cnot(2, 3), cnot(2, 4), cnot(2, 6)]
golden = np.eye(DIM, dtype=complex)
for G in gates:
    golden = G @ golden
```
