```python id=app_golden
import numpy as np
w8 = np.exp(1j * np.pi / 4)
d = np.ones(8, dtype=complex)
for idx in range(8):
    x0, x1, x2 = (idx >> 2) & 1, (idx >> 1) & 1, idx & 1
    f = (x0 + x1 + x2 + 2 * (x0 * x1 + x0 * x2 + x1 * x2) + 4 * x0 * x1 * x2) % 8
    d[idx] = w8 ** f
golden = np.diag(d)
```
