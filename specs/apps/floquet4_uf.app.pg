{"id": "floquet4_uf", "n_sys": 4, "n_anc": 0}
```
```python id=app_golden
import numpy as np
I2 = np.eye(2, dtype=complex)
H = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
T = np.diag([1, np.exp(1j * np.pi / 4)]).astype(complex)
CZ = np.diag([1, 1, 1, -1]).astype(complex)
N = 4
def emb2(g, i, j):
    dim = 2 ** N
    M = np.zeros((dim, dim), dtype=complex)
    for idx in range(dim):
        b = [(idx >> (N - 1 - q)) & 1 for q in range(N)]
        si = (b[i] << 1) | b[j]
        for so in range(4):
            a = g[so, si]
            if abs(a) < 1e-16:
                continue
            nb = list(b)
            nb[i], nb[j] = (so >> 1) & 1, so & 1
            oidx = 0
            for q in range(N):
                oidx = (oidx << 1) | nb[q]
            M[oidx, idx] += a
    return M
def emb1(g, i):
    M = np.eye(1, dtype=complex)
    for q in range(N):
        M = np.kron(M, g if q == i else I2)
    return M
Uzz = emb2(CZ, 0, 1) @ emb2(CZ, 1, 2) @ emb2(CZ, 2, 3) @ emb2(CZ, 3, 0)
RxT = H @ T @ H
Ux = emb1(RxT, 0) @ emb1(RxT, 1) @ emb1(RxT, 2) @ emb1(RxT, 3)
golden = Ux @ Uzz
```
