```python id=app_golden
import numpy as np
I = np.eye(2, dtype=complex)
def ry(a):
    return np.array([[np.cos(a/2), -np.sin(a/2)], [np.sin(a/2), np.cos(a/2)]], dtype=complex)
def emb(op, q):
    return np.kron(op, I) if q == 0 else np.kron(I, op)
def cnot(c, t):
    M = np.zeros((4, 4), dtype=complex)
    for x in range(4):
        b = [(x >> 1) & 1, x & 1]; b[t] ^= b[c]
        M[(b[0] << 1) | b[1], x] = 1.0
    return M
# CRY(π/2)(0→1) 시간순: CNOT·Ry(−π/4)_1·CNOT·Ry(π/4)_1 → 이어서 CNOT(env→sys)
golden = np.eye(4, dtype=complex)
for G in [cnot(0, 1), emb(ry(-np.pi/4), 1), cnot(0, 1), emb(ry(np.pi/4), 1), cnot(1, 0)]:
    golden = G @ golden
```
