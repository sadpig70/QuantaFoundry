```python id=app_golden
import numpy as np
from functools import reduce
NQ = 9
DIM = 512
I2 = np.eye(2, dtype=complex)
Xg = np.array([[0, 1], [1, 0]], dtype=complex)
Zg = np.array([[1, 0], [0, -1]], dtype=complex)
def emb(op, q):
    return reduce(np.kron, [op if i == q else I2 for i in range(NQ)])
def bits(v):
    return [(v >> (NQ - 1 - i)) & 1 for i in range(NQ)]
def idx(b):
    return sum((b[i] & 1) << (NQ - 1 - i) for i in range(NQ))
def cnot(c, t):
    M = np.zeros((DIM, DIM), dtype=complex)
    for v in range(DIM):
        b = bits(v); b[t] ^= b[c]
        M[idx(b), v] = 1.0
    return M
def cz2(c, t):
    M = np.eye(DIM, dtype=complex)
    for v in range(DIM):
        b = bits(v)
        if b[c] and b[t]:
            M[v, v] = -1.0
    return M
def ry(a):
    return np.array([[np.cos(a/2), -np.sin(a/2)], [np.sin(a/2), np.cos(a/2)]], dtype=complex)
ak41 = np.arccos(np.sqrt(28.0/41.0))
ak13 = np.arccos(np.sqrt(8.0/13.0))
ak7 = np.arccos(np.sqrt(2.0/7.0))
k5 = np.arccos(np.sqrt(1.0/5.0))
p4, p2 = np.pi/4, np.pi/2
def v2(x, y):
    return [cnot(y, x), emb(Xg, y), emb(ry(-p4), y), cz2(x, y),
            emb(ry(p4), y), emb(Xg, y), cnot(y, x)]
seq = []
# global -1 fix: ZXZX(q8) = -I
seq += [emb(Zg, 8), emb(Xg, 8), emb(Zg, 8), emb(Xg, 8)]
# site1 (x=0,y=1): uncontrolled y load Ry(-2*ak41), update1, V2
seq += [emb(ry(-ak41), 1), emb(ry(-ak41), 1)]
seq += [emb(Xg, 1), cnot(1, 8), emb(Xg, 1)]
seq += v2(0, 1)
# site2 (x=2,y=3): b0 anti-ctrl y load(ak13), b1 y-set + x load(ak7), updates, V2
seq += [emb(Xg, 8), cnot(8, 3), emb(ry(ak13), 3), cnot(8, 3), emb(ry(-ak13), 3), emb(Xg, 8)]
seq += [cnot(8, 3), cnot(8, 2), emb(ry(ak7), 2), cnot(8, 2), emb(ry(-ak7), 2)]
seq += [emb(Xg, 3), cnot(3, 8), emb(Xg, 3), cnot(2, 8)]
seq += v2(2, 3)
# site3 (x=4,y=5): b0 half = pi/2 - k5 (ry_pi2*ry_k5_dag 합성), b1 half = pi/4
seq += [emb(Xg, 8), cnot(8, 5), emb(ry(-k5), 5), emb(ry(p2), 5), cnot(8, 5),
        emb(ry(-p2), 5), emb(ry(k5), 5), emb(Xg, 8)]
seq += [cnot(8, 5), cnot(8, 4), emb(ry(p4), 4), cnot(8, 4), emb(ry(-p4), 4)]
seq += [emb(Xg, 5), cnot(5, 8), emb(Xg, 5), cnot(4, 8)]
seq += v2(4, 5)
# site4 (x=6,y=7): 결정론 Clifford — b0: y=1(anti), b1: x=1,y=1, update2, V2
seq += [emb(Xg, 8), cnot(8, 7), emb(Xg, 8), cnot(8, 6), cnot(8, 7), cnot(6, 8)]
seq += v2(6, 7)
golden = np.eye(DIM, dtype=complex)
for G in seq:
    golden = G @ golden
```
