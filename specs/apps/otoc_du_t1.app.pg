```python id=app_golden
import numpy as np
F1 = np.array([[1, 0, 0, 0], [0, 0, -1j, 0], [0, -1j, 0, 0], [0, 0, 0, 1]], dtype=complex)
p = np.exp(-1j * np.pi / 8)
Vg = F1 @ np.diag([p, np.conj(p), np.conj(p), p]).astype(complex)
N = 6
X1 = np.array([[0, 1], [1, 0]], dtype=complex)
I2 = np.eye(2, dtype=complex)
def e1(g, i):
    m = np.eye(1, dtype=complex)
    for k in range(N):
        m = np.kron(m, g if k == i else I2)
    return m
def e2(g, i, j):
    d = 2 ** N
    M = np.zeros((d, d), dtype=complex)
    for x in range(d):
        b = [(x >> (N - 1 - k)) & 1 for k in range(N)]
        si = (b[i] << 1) | b[j]
        for so in range(4):
            a = g[so, si]
            if abs(a) < 1e-16:
                continue
            nb = list(b)
            nb[i], nb[j] = (so >> 1) & 1, so & 1
            y = 0
            for k in range(N):
                y = (y << 1) | nb[k]
            M[y, x] += a
    return M
U = (e2(Vg, 1, 2) @ e2(Vg, 3, 4) @ e2(Vg, 5, 0)) @ (e2(Vg, 0, 1) @ e2(Vg, 2, 3) @ e2(Vg, 4, 5))
Ud = U.conj().T
XA, XB = e1(X1, 1), e1(X1, 0)
golden = Ud @ XA @ U @ XB @ Ud @ XA @ U @ XB
```
