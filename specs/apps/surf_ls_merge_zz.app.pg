```python id=app_golden
import numpy as np
from functools import reduce
I = np.eye(2, dtype=complex)
Hd = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
NQ = 9
DIM = 512
def emb(op, q):
    return reduce(np.kron, [op if i == q else I for i in range(NQ)])
def bits(x):
    return [(x >> (NQ - 1 - i)) & 1 for i in range(NQ)]
def cz(a, b_):
    M = np.eye(DIM, dtype=complex)
    for x in range(DIM):
        bb = bits(x)
        if bb[a] and bb[b_]:
            M[x, x] = -1.0
    return M
# coherent Z_L1⊗Z_L2 merge: ancilla q0 entangled with Z1Z2 (patch1) · Z5Z6 (patch2)
gates = [emb(Hd, 0), cz(0, 1), cz(0, 2), cz(0, 5), cz(0, 6), emb(Hd, 0)]
golden = np.eye(DIM, dtype=complex)
for G in gates:
    golden = G @ golden
```
