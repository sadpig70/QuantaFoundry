```
```python id=app_golden
import numpy as np
s2, s3, s6 = np.sqrt(2.0), np.sqrt(3.0), np.sqrt(6.0)
def v3(d):
    v = np.zeros(8, dtype=complex)
    for b, a in d.items():
        v[int("".join(map(str, b)), 2)] = a
    return v
L3 = {
    (0,0,0): v3({(0,0,0): 1.0}),
    (0,0,1): v3({(0,0,1): 1/s3, (0,1,0): 1/s3, (1,0,0): 1/s3}),
    (1,0,1): v3({(0,1,1): 1/s3, (1,0,1): 1/s3, (1,1,0): 1/s3}),
    (1,1,1): v3({(1,1,1): 1.0}),
    (1,0,0): v3({(1,0,0): 2/s6, (0,0,1): -1/s6, (0,1,0): -1/s6}),
    (0,1,1): v3({(0,1,1): 2/s6, (1,0,1): -1/s6, (1,1,0): -1/s6}),
    (0,1,0): v3({(0,0,1): 1/s2, (0,1,0): -1/s2}),
    (1,1,0): v3({(1,0,1): 1/s2, (1,1,0): -1/s2}),
}
U = np.zeros((8, 8), dtype=complex)
for lab, vec in L3.items():
    U[:, int("".join(map(str, lab)), 2)] = vec
golden = U.conj().T
```
