```python id=app_golden
import numpy as np
from functools import reduce
I = np.eye(2, dtype=complex)
Hd = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
NQ = 3
DIM = 8
def emb(op, q):
    return reduce(np.kron, [op if i == q else I for i in range(NQ)])
def bits(x):
    return [(x >> (NQ - 1 - i)) & 1 for i in range(NQ)]
def cnot(c, t):
    M = np.zeros((DIM, DIM), dtype=complex)
    for x in range(DIM):
        b = bits(x)
        b = b[:]; b[t] ^= b[c]
        M[sum((b[i] & 1) << (NQ - 1 - i) for i in range(NQ)), x] = 1.0
    return M
# encoder: CNOT(0,1)·CNOT(0,2)(반복부호) → H(1)(Gauss law 기저)
gates = [cnot(0, 1), cnot(0, 2), emb(Hd, 1)]
golden = np.eye(DIM, dtype=complex)
for G in gates:
    golden = G @ golden
```
