```python id=app_golden
import numpy as np
I2 = np.eye(2, dtype=complex)
H = np.array([[1, 1], [1, -1]], dtype=complex) / np.sqrt(2)
def e1(g, i):
    m = np.eye(1, dtype=complex)
    for k in range(4):
        m = np.kron(m, g if k == i else I2)
    return m
def cnot(c, t):
    d = 16
    M = np.zeros((d, d), dtype=complex)
    for x in range(d):
        b = [(x >> (3 - k)) & 1 for k in range(4)]
        if b[c]:
            b[t] ^= 1
        y = 0
        for k in range(4):
            y = (y << 1) | b[k]
        M[y, x] = 1.0
    return M
golden = (cnot(2, 3) @ cnot(1, 3) @ cnot(0, 3) @ e1(H, 0) @ e1(H, 1) @ e1(H, 2))
```
