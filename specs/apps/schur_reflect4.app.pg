```python id=app_golden
import numpy as np
P = np.zeros((16, 16), dtype=complex)
for k in range(5):
    v = np.zeros(16, dtype=complex)
    for i in range(16):
        if bin(i).count("1") == k:
            v[i] = 1.0
    v /= np.linalg.norm(v)
    P += np.outer(v, v.conj())
golden = 2 * P - np.eye(16, dtype=complex)
```
